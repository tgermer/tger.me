---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { Icon } from "astro-icon/components";

type ProjectKey = "mapply" | "clearControl" | "signatureAssistant";

type ProjectLogo = {
    src: string;
    alt: string;
    backgroundColor?: string;
};

interface Props {
    title: string;
    intro: string;
    event?: string;
    date?: Date | string;
    location?: string;
    variant?: "general" | "event";
    showMapply?: boolean;
    showClearControl?: boolean;
    showSignatureAssistant?: boolean;
    showVCard?: boolean;
    vcardHref?: string;
    vcardLabel?: string;
    ctaLabel?: string;
    ctaHref?: string;
    noindex?: boolean;
    hasContent?: boolean;
}

const { title, intro, event, date, location, variant = "general", showMapply = false, showClearControl = false, showSignatureAssistant = false, showVCard = true, vcardHref = "/tristan-germer.vcf", vcardLabel = "Kontakt speichern", ctaLabel = "Kontakt aufnehmen", ctaHref = `mailto:${site.email}`, noindex = true, hasContent = true } = Astro.props;

const formatDate = (value: Date | string) => {
    if (typeof value === "string") {
        return value;
    }
    return value.toLocaleDateString("de-DE", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};

const projects: Record<
    ProjectKey,
    {
        title: string;
        description: string;
        href: string;
        icon: string;
        logo?: ProjectLogo;
        tone: string;
    }
> = {
    mapply: {
        title: "Mapply",
        description: "Bewerben ist stressig genug. Deine Organisation muss es nicht sein. – Mapply bündelt Lebenslaufdaten, Bewerbungen, Dokumente und Bewerbungsstände an einem Ort und reduziert organisatorischen Aufwand im Bewerbungsprozess.",
        href: "https://www.mapply.me/",
        icon: "tabler:map-search",
        logo: {
            src: "/mapply-logo-1-1.svg",
            alt: "Mapply Logo",
            backgroundColor: "#0b47c4",
        },
        tone: "bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300",
    },
    clearControl: {
        title: "ClearControl.",
        description: "Zu viele Tasten. Zu wenig Klarheit. – Mach aus unübersichtlichen Smart-Home-Steuerungen klare, strukturierte und druckfertige Beschriftungen — passend zu deiner tatsächlichen Nutzung.",
        href: "https://clearcontrol.de",
        icon: "tabler:device-remote",
        logo: {
            src: "/clear-control-logo-1-1-kurz.svg",
            alt: "ClearControl Logo",
            backgroundColor: "#E7E2F6",
        },
        tone: "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300",
    },
    signatureAssistant: {
        title: "HS-Signatur-Assistent",
        description: "Vom manuellen Papierprozess zur verlustfreien digitalen Unterschrift. – Der HS-Signatur-Assistent digitalisiert Unterschriften für den Zeugnis- und Urkundendruck, reduziert aufwendige Handarbeit und ermöglicht einen konsistent hochwertigen Druck in Vektorqualität.",
        href: "https://signature.tger.me",
        icon: "tabler:signature",
        logo: {
            src: "/hs-signature-assistant-logo-1-1.svg",
            alt: "HS Signature Assistant Logo",
            backgroundColor: "#6D5CC6",
        },
        tone: "bg-violet-50 text-violet-700 dark:bg-violet-950 dark:text-violet-300",
    },
};

const selectedProjects = [showMapply && projects.mapply, showClearControl && projects.clearControl, showSignatureAssistant && projects.signatureAssistant].filter(Boolean);

const eventParts = [event, date && formatDate(date), location].filter(Boolean);
---

<BaseLayout title={title} description={intro} noindex={noindex} hideChrome>
    <section class="min-h-screen bg-gray-50 dark:bg-gray-950">
        <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-4 py-4 sm:px-6 sm:py-5 lg:px-8">
            <div class="mb-3 flex items-center">
                <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 transition-colors hover:text-blue-700 dark:text-white dark:hover:text-blue-300" aria-label="Tristan Germer">
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-bold text-white">TG</span>
                    <span>Tristan Germer</span>
                </a>
            </div>

            <div class="grid gap-3 lg:grid-cols-[minmax(0,1.08fr)_minmax(19rem,0.92fr)] lg:items-start">
                <header class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-6">
                    <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                        <Icon name={variant === "event" ? "tabler:calendar-event" : "tabler:qrcode"} class="h-4 w-4" aria-hidden="true" />
                        Connect
                    </p>
                    <h1 class="text-2xl font-bold leading-tight text-gray-950 dark:text-white sm:text-3xl">{title}</h1>
                    <p class="mt-3 text-base leading-7 text-gray-600 dark:text-gray-300">{intro}</p>

                    {
                        eventParts.length > 0 && (
                            <div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 p-4 text-sm dark:border-blue-900 dark:bg-blue-950/35">
                                <div class="flex items-start gap-3">
                                    <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-blue-700 ring-1 ring-blue-100 dark:bg-blue-950 dark:text-blue-300 dark:ring-blue-900">
                                        <Icon name="tabler:calendar-event" class="h-5 w-5" aria-hidden="true" />
                                    </span>
                                    <div class="min-w-0">
                                        {event ? <p class="font-medium leading-6 text-gray-900 dark:text-white">{event}</p> : <p class="font-medium leading-6 text-gray-900 dark:text-white">Danke fürs Vorbeischauen.</p>}
                                        {(date || location) && (
                                            <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-600 dark:text-gray-400">
                                                {date && <span>{formatDate(date)}</span>}
                                                {date && location && <span aria-hidden="true">·</span>}
                                                {location && <span>{location}</span>}
                                            </p>
                                        )}
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                        <a href={ctaHref} class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
                            <Icon name="tabler:send" class="h-4 w-4" aria-hidden="true" />
                            {ctaLabel}
                        </a>
                        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-800 transition-colors hover:border-blue-300 hover:text-blue-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-700 dark:hover:text-blue-300">
                            <Icon name="tabler:brand-linkedin" class="h-4 w-4" aria-hidden="true" />
                            LinkedIn
                        </a>
                    </div>
                </header>

                <aside class="grid gap-3">
                    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
                        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Kontakt</h2>
                        <div class="mt-3 grid gap-1 text-sm">
                            <a href={`mailto:${site.email}`} class="group flex items-center gap-3 rounded-lg px-2 py-2 text-gray-700 transition-colors hover:bg-blue-50 hover:text-blue-700 dark:text-gray-300 dark:hover:bg-blue-950 dark:hover:text-blue-300">
                                <Icon name="tabler:mail" class="h-4 w-4 shrink-0 text-gray-400 group-hover:text-blue-600" aria-hidden="true" />
                                <span>{site.email}</span>
                            </a>
                            <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="group flex items-center gap-3 rounded-lg px-2 py-2 text-gray-700 transition-colors hover:bg-blue-50 hover:text-blue-700 dark:text-gray-300 dark:hover:bg-blue-950 dark:hover:text-blue-300">
                                <Icon name="tabler:phone" class="h-4 w-4 shrink-0 text-gray-400 group-hover:text-blue-600" aria-hidden="true" />
                                <span>{site.phone}</span>
                            </a>
                            {
                                showVCard && (
                                    <a href={vcardHref} download class="group mt-1 flex items-center justify-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 font-semibold text-gray-800 transition-colors hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 dark:border-gray-800 dark:text-gray-100 dark:hover:border-blue-800 dark:hover:bg-blue-950 dark:hover:text-blue-300">
                                        <Icon name="tabler:address-book" class="h-4 w-4 shrink-0 text-gray-400 group-hover:text-blue-600" aria-hidden="true" />
                                        <span>{vcardLabel}</span>
                                    </a>
                                )
                            }
                        </div>
                    </div>

                    {
                        selectedProjects.length > 0 && (
                            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
                                <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Aktuelle Projekte</h2>
                                <div class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
                                    {selectedProjects.map(
                                        (project) =>
                                            project && (
                                                <a href={project.href} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-3 py-3 first:pt-0 last:pb-0">
                                                    <span class={`mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-lg transition-colors ${project.logo ? "" : project.tone}`} style={project.logo?.backgroundColor ? `background-color: ${project.logo.backgroundColor}` : undefined}>
                                                        {project.logo ? <img src={project.logo.src} alt={project.logo.alt} class="h-full w-full object-contain" loading="lazy" /> : <Icon name={project.icon} class="h-5 w-5" aria-hidden="true" />}
                                                    </span>
                                                    <span class="min-w-0">
                                                        <span class="flex items-center gap-1.5 text-sm font-semibold text-gray-950 transition-colors group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300">
                                                            {project.title}
                                                            <Icon name="tabler:external-link" class="h-3.5 w-3.5 shrink-0 text-gray-400 transition-colors group-hover:text-blue-600 dark:text-gray-500 dark:group-hover:text-blue-300" aria-hidden="true" />
                                                        </span>
                                                        <span class="mt-0.5 block text-sm leading-5 text-gray-600 dark:text-gray-400">{project.description}</span>
                                                    </span>
                                                </a>
                                            ),
                                    )}
                                </div>
                            </div>
                        )
                    }
                </aside>
            </div>

            {
                hasContent && (
                    <article class="prose mt-3 max-w-none rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-6 [&>:first-child]:mt-0">
                        <slot />
                    </article>
                )
            }

            <footer class="mt-auto flex flex-col items-center justify-between gap-2 px-1 py-5 text-center text-xs text-gray-500 dark:text-gray-500 sm:flex-row sm:text-left">
                <span>© {new Date().getFullYear()} Tristan Germer</span>
                <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
                    <a href={`mailto:${site.email}`} class="transition-colors hover:text-blue-700 dark:hover:text-blue-300">{site.email}</a>
                    <span aria-hidden="true">·</span>
                    <a href={site.imprintUrl} class="transition-colors hover:text-blue-700 dark:hover:text-blue-300">Impressum</a>
                    <span aria-hidden="true">·</span>
                    <a href={site.privacyUrl} class="transition-colors hover:text-blue-700 dark:hover:text-blue-300">Datenschutz</a>
                </div>
            </footer>
        </div>
    </section>
</BaseLayout>
