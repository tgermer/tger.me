---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const listed = sorted.filter(p => !p.data.unlisted);
  return sorted.map((post) => {
    // Unlisted posts have no prev/next navigation; listed posts navigate only between listed posts
    const navList = post.data.unlisted ? [] : listed;
    const idx = navList.findIndex(p => p.id === post.id);
    return {
      params: { slug: post.id },
      props: {
        post,
        olderPost: idx >= 0 && navList[idx + 1] ? { slug: navList[idx + 1].id, title: navList[idx + 1].data.title } : null,
        newerPost: idx >= 0 && navList[idx - 1] ? { slug: navList[idx - 1].id, title: navList[idx - 1].data.title } : null,
      },
    };
  });
}

const { post, olderPost, newerPost } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.length >= 4;
const dateStr = post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
const ogImage = `/og/blog/${post.id}.jpg`;
const hasMermaid = post.body.includes('```mermaid');
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={ogImage} ogType="article" noindex={post.data.unlisted}>
  <div class="pt-24 pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/blog" class="reveal inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline mb-4">
        <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
        Zurück zur Übersicht
      </a>

      <article>
        <header class="reveal mb-8">
          <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400">
            <Icon name="tabler:calendar" class="h-3.5 w-3.5" aria-hidden="true" />
            {dateStr}
          </time>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mt-2">{post.data.title}</h1>
        </header>

        {post.data.image && (
          <div class="reveal relative mb-10 h-64 overflow-hidden rounded-2xl shadow-lg sm:h-80 md:h-96">
            <Image
              src={post.data.image}
              alt={post.data.title}
              layout="full-width"
              class="h-full w-full object-cover"
              style={`object-position: ${post.data.imagePosition};`}
            />
            {post.data.imageAiGenerated && (
              <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full border border-white/50 bg-white/75 px-2.5 py-1 text-xs font-medium text-gray-700 shadow-sm backdrop-blur dark:border-gray-700/60 dark:bg-gray-950/55 dark:text-gray-200">
                <Icon name="tabler:sparkles" class="h-3.5 w-3.5" aria-hidden="true" />
                KI-generiertes Bild
              </span>
            )}
          </div>
        )}

        <div class:list={['blog-layout', { 'has-toc': showToc }]}>
          {showToc && (
            <nav class="blog-toc" aria-label="Inhaltsverzeichnis">
              <div class="blog-toc-sticky">
                <details>
                  <summary class="blog-toc-toggle">Inhaltsverzeichnis</summary>
                  <ol class="blog-toc-list">
                    {tocHeadings.map(h => (
                      <li class={h.depth === 3 ? 'blog-toc-h3' : undefined}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ol>
                </details>
              </div>
            </nav>
          )}

          <div>
            <div class="prose max-w-none text-gray-700 dark:text-gray-300" data-blog-content>
              <Content />
            </div>

            {post.data.showContact && (
              <p class="mt-8 text-sm text-gray-500 dark:text-gray-400">
                Fragen oder Anmerkungen? Schreib mir an <a href={`mailto:${site.email}`} class="text-blue-600 dark:text-blue-400 hover:underline">{site.email}</a>
              </p>
            )}
          </div>
        </div>
      </article>

      <!-- Navigation -->
      <nav class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-800">
        <div class="flex items-center justify-between mb-6">
          {olderPost ? (
            <a href={`/blog/${olderPost.slug}`} class="group flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors max-w-[45%]">
              <Icon name="tabler:arrow-left" class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="truncate">{olderPost.title}</span>
            </a>
          ) : <div />}
          {newerPost ? (
            <a href={`/blog/${newerPost.slug}`} class="group flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors max-w-[45%] ml-auto text-right">
              <span class="truncate">{newerPost.title}</span>
              <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
            </a>
          ) : <div />}
        </div>
        <div class="text-center">
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 dark:border-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors">
            <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
            Alle Beiträge
          </a>
        </div>
      </nav>
    </div>
  </div>
  <script>
    function wrapBlogSections() {
      const container = document.querySelector('[data-blog-content]');
      if (!container) return;

      const children = Array.from(container.children);
      const sections: Element[][] = [[]];

      for (const child of children) {
        if (child.tagName === 'H2') {
          sections.push([]);
        }
        sections[sections.length - 1].push(child);
      }

      container.innerHTML = '';
      for (const section of sections) {
        if (section.length === 0) continue;
        const wrapper = document.createElement('div');
        wrapper.classList.add('reveal');
        for (const el of section) {
          wrapper.appendChild(el);
        }
        container.appendChild(wrapper);
      }
    }

    wrapBlogSections();
    document.addEventListener('astro:after-swap', wrapBlogSections);
  </script>
  <script>
    function initScrollSpy() {
      const tocList = document.querySelector('.blog-toc-list');
      if (!tocList) return;

      const tocLinks = tocList.querySelectorAll('a');
      const headings: { el: HTMLElement; link: HTMLAnchorElement }[] = [];

      tocLinks.forEach(link => {
        const id = link.getAttribute('href')?.slice(1);
        const el = id ? document.getElementById(id) : null;
        if (el) headings.push({ el, link: link as HTMLAnchorElement });
      });

      if (!headings.length) return;

      let ticking = false;

      function update() {
        const offset = 100;
        let active = headings[0];

        for (const h of headings) {
          if (h.el.getBoundingClientRect().top <= offset) {
            active = h;
          } else {
            break;
          }
        }

        tocLinks.forEach(l => l.classList.remove('active'));
        active?.link.classList.add('active');
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      update();
    }

    initScrollSpy();
    document.addEventListener('astro:after-swap', initScrollSpy);
  </script>
  <script>
    function initTocDetails() {
      const details = document.querySelector('.blog-toc details') as HTMLDetailsElement | null;
      if (!details) return;

      const mq = window.matchMedia('(min-width: 1600px)');

      function sync() {
        if (mq.matches) {
          details!.open = true;
          details!.addEventListener('toggle', forceOpen);
        } else {
          details!.removeEventListener('toggle', forceOpen);
        }
      }

      function forceOpen() {
        if (mq.matches && !details!.open) {
          details!.open = true;
        }
      }

      mq.addEventListener('change', sync);
      sync();
    }

    initTocDetails();
    document.addEventListener('astro:after-swap', initTocDetails);
  </script>
  {hasMermaid && (
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      function initMermaid() {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"] > code, pre > code.language-mermaid');
        if (!blocks.length) return;

        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
          securityLevel: 'strict',
        });

        blocks.forEach((block, index) => {
          const pre = block.parentElement;
          if (!pre || pre.dataset.mermaidRendered === 'true') return;
          pre.dataset.mermaidRendered = 'true';

          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid blog-mermaid';
          wrapper.id = `mermaid-${index}`;
          wrapper.textContent = block.textContent || '';
          pre.replaceWith(wrapper);
        });

        mermaid.run({ querySelector: '.blog-mermaid' });
      }

      initMermaid();
      document.addEventListener('astro:after-swap', initMermaid);
    </script>
  )}
</BaseLayout>
