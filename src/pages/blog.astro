---
import PageLayout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { pages } from '../data/pages';
import { site } from '../data/site';

const posts = await getCollection('blog');
const sorted = posts.filter(p => !p.data.unlisted).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const unlisted = import.meta.env.DEV ? posts.filter(p => p.data.unlisted).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) : [];
---

<PageLayout title="Blog" description={pages.blog.description} subtitle="Artikel und Neuigkeiten" ogImage="/og/blog.jpg" revealContent={false}>
  <div class="space-y-6">
    {sorted.map((post, index) => {
      const dateStr = post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
      const isHero = index === 0;

      return isHero ? (
        /* Hero card – first post, full-width image */
        <a href={`/blog/${post.id}`} class="reveal group block bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          {post.data.image ? (
            <div class="relative h-64 sm:h-72 overflow-hidden">
              <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" style={`object-position: ${post.data.imagePosition};`} widths={[800, 1200]} sizes="(min-width: 1024px) 960px, 100vw" />
            </div>
          ) : (
            <div class="h-1.5 gradient-brand" />
          )}
          <div class="p-6">
            <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-500 mb-2">
              <Icon name="tabler:calendar" class="h-3.5 w-3.5" aria-hidden="true" />
              {dateStr}
            </time>
            <h3 class="font-bold text-xl sm:text-2xl leading-snug text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="mt-3 text-gray-600 dark:text-gray-400 line-clamp-4">{post.data.description}</p>
            )}
          </div>
        </a>
      ) : (
        /* Regular card – horizontal with side image on sm+ */
        <a href={`/blog/${post.id}`} class="reveal group block bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="sm:flex">
            {post.data.image ? (
              <div class="relative h-48 sm:h-auto sm:w-56 shrink-0 overflow-hidden">
                <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" style={`object-position: ${post.data.imagePosition};`} widths={[400, 800]} sizes="(min-width: 640px) 224px, 100vw" />
              </div>
            ) : (
              <div class="h-1.5 sm:h-auto sm:w-1.5 gradient-brand shrink-0" />
            )}
            <div class="p-5 flex-1 min-w-0">
              <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-500 mb-2">
                <Icon name="tabler:calendar" class="h-3.5 w-3.5" aria-hidden="true" />
                {dateStr}
              </time>
              <h3 class="font-semibold text-base leading-snug text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-3">{post.data.description}</p>
              )}
            </div>
          </div>
        </a>
      );
    })}
  </div>

  {unlisted.length > 0 && (
    <div class="mt-12 pt-8 border-t border-dashed border-gray-300 dark:border-gray-700">
      <h2 class="reveal text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-4">Unlisted</h2>
      <div class="space-y-3">
        {unlisted.map((post) => {
          const dateStr = post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
          return (
            <div class="reveal group relative bg-gray-50 dark:bg-gray-900 rounded-2xl border border-dashed border-gray-200 dark:border-gray-800 overflow-hidden hover:border-gray-300 dark:hover:border-gray-700 transition-colors">
              <a href={`/blog/${post.id}`} class="absolute inset-0 z-0" aria-label={post.data.title} />
              <div class="sm:flex">
                {post.data.image ? (
                  <div class="relative h-48 sm:h-auto sm:w-56 shrink-0 overflow-hidden">
                    <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" style={`object-position: ${post.data.imagePosition};`} widths={[400, 800]} sizes="(min-width: 640px) 224px, 100vw" />
                  </div>
                ) : (
                  <div class="h-1.5 sm:h-auto sm:w-1.5 bg-gray-300 dark:bg-gray-700 shrink-0" />
                )}
                <div class="p-5 flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <Icon name="tabler:eye-off" class="h-3.5 w-3.5 text-gray-400" aria-hidden="true" />
                    <time datetime={post.data.date.toISOString()} class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-500">
                      <Icon name="tabler:calendar" class="h-3.5 w-3.5" aria-hidden="true" />
                      {dateStr}
                    </time>
                    <button type="button" data-copy-url={`${site.url}/blog/${post.id}`} class="relative z-10 ml-auto inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs text-gray-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:text-blue-400 dark:hover:bg-blue-950 transition-colors cursor-pointer">
                      <Icon name="tabler:link" class="h-3.5 w-3.5 copy-icon" aria-hidden="true" />
                      <Icon name="tabler:check" class="h-3.5 w-3.5 check-icon hidden" aria-hidden="true" />
                      <span class="copy-label">URL kopieren</span>
                    </button>
                  </div>
                  <h3 class="font-semibold text-base leading-snug text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-3">{post.data.description}</p>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}
  <script>
    function initCopyButtons() {
      document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const url = btn.dataset.copyUrl!;
          navigator.clipboard.writeText(url).then(() => {
            const linkIcon = btn.querySelector('.copy-icon')! as HTMLElement;
            const checkIcon = btn.querySelector('.check-icon')! as HTMLElement;
            const label = btn.querySelector('.copy-label')! as HTMLElement;
            linkIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            label.textContent = 'Kopiert!';
            btn.classList.add('text-green-600', 'dark:text-green-400');
            setTimeout(() => {
              linkIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
              label.textContent = 'URL kopieren';
              btn.classList.remove('text-green-600', 'dark:text-green-400');
            }, 2000);
          });
        });
      });
    }
    initCopyButtons();
    document.addEventListener('astro:after-swap', initCopyButtons);
  </script>
</PageLayout>
